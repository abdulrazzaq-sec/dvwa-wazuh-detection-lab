<group name="local,syslog,sshd,dvwa,brute_force,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100010" level="5">
    <if_group>web</if_group>
    <url>/dvwa/vulnerabilities/brute/</url>
    <description>DVWA Brute Force page accessed</description>
    <group>dvwa,brute_force,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100011" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>DVWA Brute Force Attack Detected - multiple login attempts from same source IP</description>
    <group>dvwa,brute_force,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100012" level="10">
    <if_group>web</if_group>
    <url>sqli</url>
    <regex type="pcre2">(\x27|%27).*(OR|UNION|SELECT|--|%2D%2D)</regex>
    <description>SQL Injection Attempt Detected on DVWA</description>
    <group>dvwa,sql_injection,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100013" level="10">
    <if_group>web</if_group>
    <url>xss_r</url>
    <regex type="pcre2">(%3Cscript%3E|&lt;script&gt;)</regex>
    <description>XSS (Reflected) Attack Attempt Detected on DVWA</description>
    <group>dvwa,xss,</group>
    <mitre>
      <id>T1059.007</id>
    </mitre>
  </rule>

</group>
